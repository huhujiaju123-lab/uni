<!--components/empty-state/empty-state.wxml-->
<view class="empty-state">
  <image class="empty-image" src="{{image || '/images/empty-default.png'}}" mode="aspectFit"></image>
  <text class="empty-text">{{text || '暂无数据'}}</text>
  <button class="empty-btn" wx:if="{{buttonText}}" bindtap="onButtonTap">{{buttonText}}</button>
</view>
