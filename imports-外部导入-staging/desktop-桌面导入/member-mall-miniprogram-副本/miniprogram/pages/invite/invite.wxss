/* pages/invite/invite.wxss */

.container {
  min-height: 100vh;
  background-color: #F6F6F6;
}

/* 头部邀请码卡片 */
.header {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #000000 0%, #333333 100%);
}

.invite-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
}

.card-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 24rpx;
}

.invite-code {
  font-size: 72rpx;
  font-weight: 700;
  color: #FA5400;
  letter-spacing: 16rpx;
  margin-bottom: 24rpx;
}

.invite-count {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  margin-top: -40rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn::after {
  display: none;
}

.action-btn.copy {
  background-color: #FFFFFF;
  color: #000000;
  border: 2rpx solid #E5E5E5;
}

.action-btn.share {
  background-color: #FA5400;
  color: #FFFFFF;
}

/* Section */
.section {
  margin: 24rpx;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #000000;
  margin-bottom: 24rpx;
}

/* 规则 */
.rules {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rule-item {
  display: flex;
  align-items: center;
}

.rule-num {
  width: 40rpx;
  height: 40rpx;
  background-color: #F6F6F6;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666666;
  margin-right: 16rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #666666;
}

/* 邀请记录 */
.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F6F6F6;
}

.record-item:last-child {
  border-bottom: none;
}

.record-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #F6F6F6;
  margin-right: 20rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 28rpx;
  color: #000000;
  margin-bottom: 4rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999999;
}

.empty-records {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}
