/* pages/order/list.wxss */

.container {
  min-height: 100vh;
  background-color: #F6F6F6;
}

/* 状态 tabs */
.status-tabs {
  display: flex;
  background-color: #FFFFFF;
  padding: 0 16rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #000000;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: #000000;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  height: calc(100vh - 88rpx);
  padding: 24rpx;
}

/* 订单卡片 */
.order-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #F6F6F6;
}

.order-no {
  font-size: 24rpx;
  color: #999999;
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.order-status.pending {
  color: #FA5400;
}

.order-status.paid,
.order-status.shipped {
  color: #07C160;
}

.order-status.completed,
.order-status.cancelled {
  color: #999999;
}

/* 商品列表 */
.order-items {
  padding: 24rpx;
}

.order-item {
  display: flex;
  padding: 12rpx 0;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #F6F6F6;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  color: #000000;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 28rpx;
  color: #000000;
  font-weight: 500;
}

.item-quantity {
  font-size: 26rpx;
  color: #999999;
}

/* 订单底部 */
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-top: 1rpx solid #F6F6F6;
}

.order-total {
  font-size: 26rpx;
  color: #666666;
}

.total-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #FA5400;
  margin-left: 8rpx;
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  margin: 0;
}

.action-btn::after {
  display: none;
}

.action-btn.cancel {
  background-color: #FFFFFF;
  color: #666666;
  border: 1rpx solid #E5E5E5;
}

.action-btn.pay,
.action-btn.confirm {
  background-color: #000000;
  color: #FFFFFF;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #999999;
}
