<!--pages/index/index.wxml-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar" bindtap="goToSearch">
    <view class="search-input">
      <image class="search-icon" src="/images/icon-search.png" mode="aspectFit"></image>
      <text class="search-placeholder">搜索商品</text>
    </view>
  </view>

  <!-- 主体内容 -->
  <view class="main-content">
    <!-- 左侧分类导航 -->
    <scroll-view class="category-nav" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        class="category-item {{currentCategory === item._id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="_id"
        bindtap="onCategoryTap"
        data-id="{{item._id}}"
      >
        <view class="category-indicator" wx:if="{{currentCategory === item._id}}"></view>
        <text class="category-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商品列表 -->
    <scroll-view
      class="product-list"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled
      refresher-triggered="{{isRefreshing}}"
      bindrefresherrefresh="onRefresh"
      bindscrolltolower="onLoadMore"
    >
      <!-- 商品网格 -->
      <view class="product-grid">
        <view
          class="product-item"
          wx:for="{{products}}"
          wx:key="_id"
          bindtap="goToDetail"
          data-id="{{item._id}}"
        >
          <!-- 商品图片 -->
          <image
            class="product-image"
            src="{{item.images[0] || '/images/placeholder.png'}}"
            mode="aspectFill"
            lazy-load
          ></image>

          <!-- 商品信息 -->
          <view class="product-info">
            <text class="product-name ellipsis-2">{{item.name}}</text>

            <!-- 价格显示 - 高级会员 -->
            <view class="price-section" wx:if="{{userRole === 'premium'}}">
              <text class="price-member">¥{{item.memberPrice}}</text>
              <text class="price-original">¥{{item.originalPrice}}</text>
            </view>

            <!-- 价格显示 - 普通会员 -->
            <view class="price-section" wx:else>
              <text class="price-normal">¥{{item.originalPrice}}</text>
              <view class="member-hint">
                <image class="lock-icon" src="/images/icon-lock.png" mode="aspectFit"></image>
                <text>高级会员 ¥{{item.memberPrice}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载状态 -->
      <view class="loading-more" wx:if="{{isLoading}}">
        <text>加载中...</text>
      </view>

      <!-- 没有更多 -->
      <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">
        <text>- 没有更多了 -</text>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!isLoading && products.length === 0}}">
        <image class="empty-image" src="/images/empty-product.png" mode="aspectFit"></image>
        <text class="empty-text">暂无商品</text>
      </view>
    </scroll-view>
  </view>
</view>
